@model MiladTV.Models.Client


                @{
    ViewData["Title"] = "Editace";
}

<form class="d-flex flex-column gap-2 mt-3" asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Title" class="form-label">Titulek</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Website" class="form-label">Website</label>
        <textarea asp-for="Website" class="form-control"></textarea>
        <span asp-validation-for="Website" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description" class="form-label">Obsah</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <button type="submit" class="clanky-tlacitko">Uložit</button>
    </div>
    <input type="hidden" asp-for="Id" />
</form>

<a class="clanky-tlacitko" asp-action="Index">Zpět na seznam</a>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.0.3/tinymce.min.js"></script>
    <script src="~/js/initTinyMCE.js"></script>
}